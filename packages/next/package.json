{
	"name": "@vetojs/next",
	"version": "0.1.0",
	"description": "Next.js guards for @vetojs — createGuard wraps server actions and route handlers with the actor, the row and the payload check.",
	"keywords": [
		"authorization",
		"permissions",
		"access-control",
		"nextjs",
		"server-actions",
		"rsc",
		"casl-alternative",
		"typescript"
	],
	"homepage": "https://github.com/ivan-yuldashev/veto/tree/main/packages/next#readme",
	"bugs": "https://github.com/ivan-yuldashev/veto/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivan-yuldashev/veto.git",
		"directory": "packages/next"
	},
	"license": "MIT",
	"author": "Ivan Yuldashev <geekk@ya.ru>",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"prepack": "pnpm build",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@vetojs/core": ">=0.4.0 <1"
	},
	"devDependencies": {
		"@vetojs/core": "workspace:^"
	}
}
