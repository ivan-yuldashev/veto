{
	"name": "@vetojs/next",
	"version": "0.2.0",
	"description": "Deprecated — the guard now ships as @vetojs/core/guard and works with any framework. This package re-exports it and receives no further changes.",
	"keywords": [
		"authorization",
		"permissions",
		"access-control",
		"nextjs",
		"server-actions",
		"rsc",
		"deprecated",
		"typescript"
	],
	"homepage": "https://github.com/ivan-yuldashev/vetojs/tree/main/packages/next#readme",
	"bugs": "https://github.com/ivan-yuldashev/vetojs/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ivan-yuldashev/vetojs.git",
		"directory": "packages/next"
	},
	"license": "MIT",
	"author": "Ivan Yuldashev <geekk@ya.ru>",
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"prepack": "pnpm build",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@vetojs/core": ">=0.7.0 <1"
	},
	"devDependencies": {
		"@vetojs/core": "workspace:^"
	}
}
