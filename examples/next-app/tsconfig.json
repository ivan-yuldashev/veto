{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "Preserve",
		"moduleResolution": "Bundler",
		"jsx": "preserve",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"declaration": false,
		"declarationMap": false,
		"noEmit": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"allowJs": true,
		"incremental": true
	},
	"include": ["src", "next-env.d.ts", ".next/types/**/*.ts"],
	"exclude": ["node_modules"]
}
